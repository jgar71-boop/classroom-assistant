# Variables del Classroom Assistant. Copia este archivo a .env y completa los secretos.
# Nunca subas .env al repositorio.

# Fase 1: registro y asistente
MODEL_PROVIDER=fake
AGENT_MAX_STEPS=3
MAX_QUESTION_CHARS=2000
STUDENTS_PATH=data/students.json

# Fase 2: observabilidad
SERVICE_NAME=classroom-assistant
SLO_P95_MS=2000
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
HIDE_INPUTS=true
HIDE_OUTPUTS=true

# Fase 3: modelo real (MODEL_PROVIDER=gateway) y palancas de costo
CF_ACCOUNT_ID=
CF_GATEWAY_ID=default
CF_API_TOKEN=
# Secreto opcional. Solo si el AI Gateway tiene «Authenticated Gateway»: token con
# permiso AI Gateway: Run, se manda en cf-aig-authorization.
CF_AIG_TOKEN=
MODEL_SMALL=@cf/meta/llama-3.1-8b-instruct-fast
MODEL_LARGE=@cf/meta/llama-3.3-70b-instruct-fp8-fast
ROUTING=true
ROUTER_MAX_CHARS=80
HISTORY_WINDOW=6
MODEL_MAX_TOKENS=300
MODEL_TEMPERATURE=0
MODEL_TIMEOUT_SECONDS=20
CACHE_TTL_SECONDS=0
PRICES_PATH=data/model_prices.json

# Fase 4: producción
# Con production se aplican las reglas de compliance (doc/compliance-checklist.md).
ENVIRONMENT=development
# Secreto. Forma: cliente:clave,cliente2:clave2 (en producción, claves de 16 o más
# caracteres). Sin claves, todas las rutas protegidas responden 401.
API_KEYS=
RATE_LIMIT_PER_MINUTE=30
